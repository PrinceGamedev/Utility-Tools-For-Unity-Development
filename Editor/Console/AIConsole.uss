/* AI Console — Utility Tools. Theme variables first, then layout, then components. */

.aic--dark {
    --aic-bg: #1d1e21;
    --aic-panel: #24262a;
    --aic-raised: #2b2d32;
    --aic-border: #34373d;
    --aic-text: #d8dadf;
    --aic-dim: #8a8f98;
    --aic-faint: #5d626b;
    --aic-hover: rgba(255, 255, 255, 0.045);
    --aic-selected: #264f78;
    --aic-accent: #5aa2ff;
    --aic-error: #ff5f5a;
    --aic-error-bg: rgba(255, 95, 90, 0.09);
    --aic-warning: #f2c14e;
    --aic-warning-bg: rgba(242, 193, 78, 0.07);
    --aic-ok: #4cc38a;
    --aic-code-bg: #16171a;
    --aic-code-hl: rgba(255, 95, 90, 0.16);
}

.aic--light {
    --aic-bg: #f4f5f7;
    --aic-panel: #ffffff;
    --aic-raised: #eceef1;
    --aic-border: #d6d9de;
    --aic-text: #1f2328;
    --aic-dim: #626a75;
    --aic-faint: #9aa1ab;
    --aic-hover: rgba(0, 0, 0, 0.04);
    --aic-selected: #cfe2ff;
    --aic-accent: #1f6feb;
    --aic-error: #cf222e;
    --aic-error-bg: rgba(207, 34, 46, 0.07);
    --aic-warning: #9a6700;
    --aic-warning-bg: rgba(191, 135, 0, 0.08);
    --aic-ok: #1a7f37;
    --aic-code-bg: #f6f8fa;
    --aic-code-hl: rgba(207, 34, 46, 0.10);
}

/* ---------- Layout ---------- */
.aic-root {
    flex-grow: 1;
    background-color: var(--aic-bg);
    color: var(--aic-text);
}

.aic-toolbar {
    flex-shrink: 0;
    overflow: hidden;
}

/* Clear and Collapse never shrink or get cut off */
.aic-toolbar__fixed {
    flex-shrink: 0;
}

.aic-toolbar__spacer {
    flex-grow: 1;
}

.aic-search {
    width: 280px;
    min-width: 120px;
    flex-shrink: 1;
}

.aic-type-toggle {
    flex-shrink: 0;
    min-width: 46px;
    -unity-text-align: middle-left;
}

.aic-type-toggle__icon {
    width: 16px;
    height: 16px;
    margin-right: 3px;
    flex-shrink: 0;
}

/* Main row: side bar | content column */
.aic-main {
    flex-direction: row;
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
}

.aic-content {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
}

/* ---------- Side bar: slim icon strip ---------- */
.aic-rail {
    width: 32px;
    flex-shrink: 0;
    align-items: center;
    background-color: var(--aic-panel);
    border-right-width: 1px;
    border-color: var(--aic-border);
}

.aic-rail__toggle {
    width: 100%;
    height: 22px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    -unity-text-align: middle-center;
    color: var(--aic-dim);
    border-bottom-width: 1px;
    border-color: var(--aic-border);
}

.aic-rail__toggle:hover {
    background-color: var(--aic-hover);
}

.aic-rail__toggle-icon {
    width: 12px;
    height: 12px;
    opacity: 0.7;
}

.aic-rail__groups {
    flex-grow: 1;
    width: 100%;
    align-items: center;
    padding: 4px 0;
}

.aic-rail__spacer {
    flex-grow: 1;
}

.aic-rail__sep {
    width: 16px;
    height: 1px;
    margin: 5px 0;
    background-color: var(--aic-border);
}

.aic-rail__btn {
    width: 26px;
    height: 26px;
    margin: 1px 0;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    border-left-width: 2px;
    border-left-color: rgba(0, 0, 0, 0);
}

.aic-rail__btn:hover {
    background-color: var(--aic-hover);
}

.aic-rail__btn:active {
    background-color: var(--aic-raised);
}

.aic-rail__icon {
    width: 16px;
    height: 16px;
    opacity: 0.55;
}

.aic-rail__btn:hover .aic-rail__icon {
    opacity: 0.9;
}

.aic-rail__fallback {
    font-size: 9px;
    -unity-font-style: bold;
    color: var(--aic-dim);
    padding: 0;
    margin: 0;
}

/* On: full-strength icon, faint accent background, accent marker on the left */
.aic-rail__btn--on {
    background-color: rgba(90, 162, 255, 0.14);
    border-left-color: var(--aic-accent);
}

.aic-rail__btn--on .aic-rail__icon {
    opacity: 1;
    --unity-image-tint-color: var(--aic-accent);
}

.aic-rail__btn--on .aic-rail__fallback {
    color: var(--aic-accent);
}

/* Small mode letter on cycling buttons (Sort) */
.aic-rail__badge {
    position: absolute;
    right: 1px;
    bottom: 0;
    font-size: 8px;
    -unity-font-style: bold;
    color: var(--aic-accent);
    padding: 0;
    margin: 0;
}

.aic-rail--collapsed {
    width: 12px;
}

.aic-rail--collapsed .aic-rail__groups {
    display: none;
}

.aic-rail--collapsed .aic-rail__toggle {
    height: 100%;
    border-bottom-width: 0;
    justify-content: flex-start;
    padding-top: 5px;
}

/* Body: list | splitter | details. Column by default, row when details dock to the right. */
.aic-body {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: column;
    min-height: 0;
}

.aic-body--side {
    flex-direction: row;
}

.aic-list-host {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 40px;
    min-width: 160px;
}

.aic-list {
    flex-grow: 1;
    background-color: var(--aic-bg);
}

.aic-empty--overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.aic-splitter {
    flex-shrink: 0;
    background-color: var(--aic-border);
    border-color: var(--aic-bg);
}

.aic-splitter--v {
    height: 5px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    cursor: resize-vertical;
}

.aic-splitter--h {
    width: 5px;
    border-left-width: 1px;
    border-right-width: 1px;
    cursor: resize-horizontal;
}

.aic-splitter:hover {
    background-color: var(--aic-accent);
}

.aic-details-pane {
    flex-shrink: 0;
    background-color: var(--aic-panel);
    min-height: 22px;
    min-width: 30px;
}

.aic-details-header {
    flex-direction: row;
    align-items: center;
    height: 22px;
    flex-shrink: 0;
    padding: 0 6px 0 4px;
    border-bottom-width: 1px;
    border-color: var(--aic-border);
    background-color: var(--aic-raised);
}

.aic-pane-title {
    font-size: 10px;
    -unity-font-style: bold;
    color: var(--aic-dim);
    letter-spacing: 1px;
    padding: 0;
    margin: 0;
}

.aic-dock-button {
    font-size: 10px;
    height: 16px;
    padding: 0 6px;
    margin: 0;
}

.aic-details {
    flex-grow: 1;
    background-color: var(--aic-panel);
}

/* Collapsed details: header only (bottom dock) or a thin vertical strip (right dock). */
.aic-details-pane--collapsed .aic-details,
.aic-details-pane--collapsed .aic-dock-button {
    display: none;
}

.aic-body--side .aic-details-pane--collapsed .aic-pane-title {
    display: none;
}

/* ▾ / ▸ arrows that open and close panels */
.aic-arrow {
    flex-shrink: 0;
    min-width: 16px;
    font-size: 11px;
    color: var(--aic-dim);
    -unity-text-align: middle-left;
    padding: 0 4px;
    margin: 0 2px 0 0;
    border-radius: 3px;
}

.aic-arrow:hover {
    color: var(--aic-text);
    background-color: var(--aic-hover);
}

.aic-panel--collapsed {
    height: 20px;
    padding-top: 0;
    padding-bottom: 0;
    align-items: center;
}

.aic-panel--collapsed .aic-timeline__bars,
.aic-panel--collapsed .aic-systems__chips {
    display: none;
}

.aic-hidden {
    display: none;
}

/* Search moves here on very narrow windows */
.aic-search-row {
    flex-direction: row;
    flex-shrink: 0;
    padding: 2px 4px;
    border-bottom-width: 1px;
    border-color: var(--aic-border);
    background-color: var(--aic-raised);
}

.aic-search-row .aic-search {
    flex-grow: 1;
    width: auto;
}

/* ---------- Responsive ---------- */
.aic--narrow .aic-row__fields {
    display: none;
}

.aic--narrow .aic-search {
    width: 160px;
}

.aic--narrow .aic-type-toggle {
    min-width: 36px;
}

.aic--tiny .aic-row__id {
    display: none;
}

.aic--tiny .aic-row__time {
    width: 60px;
}

.aic--tiny .aic-row__system {
    max-width: 70px;
}

.aic-details > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container {
    padding: 10px 12px 14px 12px;
}

.aic-statusbar {
    flex-direction: row;
    flex-shrink: 0;
    height: 20px;
    padding: 0 8px;
    align-items: center;
    border-top-width: 1px;
    border-color: var(--aic-border);
    background-color: var(--aic-raised);
}

.aic-statusbar__left {
    flex-grow: 1;
    color: var(--aic-dim);
    font-size: 11px;
}

.aic-statusbar__ai {
    font-size: 11px;
    color: var(--aic-dim);
    padding: 0 4px;
    border-radius: 3px;
}

.aic-statusbar__ai:hover {
    background-color: var(--aic-hover);
    color: var(--aic-text);
}

.aic-statusbar__ai--on {
    color: var(--aic-ok);
}

/* ---------- Banner ---------- */
.aic-banner {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    padding: 5px 10px;
    border-bottom-width: 1px;
    border-color: var(--aic-border);
}

.aic-banner--error {
    background-color: var(--aic-error-bg);
    border-left-width: 3px;
    border-left-color: var(--aic-error);
}

.aic-banner--busy {
    background-color: var(--aic-raised);
    border-left-width: 3px;
    border-left-color: var(--aic-accent);
}

.aic-banner__title {
    -unity-font-style: bold;
    margin-right: 8px;
}

.aic-banner--error .aic-banner__title {
    color: var(--aic-error);
}

.aic-banner__text {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    color: var(--aic-text);
}

/* ---------- Systems bar ---------- */
.aic-systems__chips {
    flex-direction: row;
    flex-wrap: wrap;
    flex-grow: 1;
    flex-shrink: 1;
}

.aic-systems {
    flex-direction: row;
    flex-shrink: 0;
    align-items: flex-start;
    padding: 4px 6px 2px 2px;
    border-bottom-width: 1px;
    border-color: var(--aic-border);
    background-color: var(--aic-panel);
}

.aic-chip {
    flex-direction: row;
    align-items: center;
    height: 20px;
    padding: 0 8px 0 6px;
    margin: 0 4px 3px 0;
    border-radius: 10px;
    border-width: 1px;
    border-color: var(--aic-border);
    background-color: var(--aic-raised);
}

.aic-chip:hover {
    border-color: var(--aic-dim);
}

.aic-chip--selected {
    border-color: var(--aic-accent);
    background-color: var(--aic-selected);
}

.aic-chip--off {
    opacity: 0.45;
}

.aic-chip__dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    margin-right: 5px;
}

.aic-chip__label {
    font-size: 11px;
    padding: 0;
    margin: 0;
}

.aic-chip__count {
    font-size: 10px;
    color: var(--aic-dim);
    margin-left: 5px;
    padding: 0;
}

.aic-chip__count--error {
    color: var(--aic-error);
}

/* ---------- Timeline ---------- */
.aic-timeline__bars {
    flex-direction: row;
    flex-grow: 1;
    height: 100%;
    align-items: flex-end;
}

.aic-timeline {
    flex-direction: row;
    flex-shrink: 0;
    height: 26px;
    padding: 3px 6px 3px 2px;
    align-items: flex-end;
    border-bottom-width: 1px;
    border-color: var(--aic-border);
    background-color: var(--aic-panel);
}

.aic-timeline__col {
    flex-grow: 1;
    flex-basis: 0;
    height: 100%;
    margin: 0 1px;
    justify-content: flex-end;
    border-radius: 2px;
}

.aic-timeline__col:hover {
    background-color: var(--aic-hover);
}

.aic-timeline__bar {
    flex-shrink: 0;
    border-radius: 1px;
}

.aic-timeline__bar--error {
    background-color: var(--aic-error);
}

.aic-timeline__bar--warning {
    background-color: var(--aic-warning);
}

.aic-timeline__bar--log {
    background-color: var(--aic-faint);
}

/* ---------- Rows ---------- */
.aic-list .unity-collection-view__item--selected {
    background-color: var(--aic-selected);
}

.aic-row {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    height: 100%;
    padding-right: 8px;
}

.aic-row:hover {
    background-color: var(--aic-hover);
}

.aic-row--error {
    background-color: var(--aic-error-bg);
}

.aic-row--warning {
    background-color: var(--aic-warning-bg);
}

.aic-row__strip {
    width: 3px;
    height: 100%;
    margin-right: 6px;
    flex-shrink: 0;
}

.aic-row__icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin-right: 6px;
}

.aic-row__time {
    width: 82px;
    flex-shrink: 0;
    font-size: 11px;
    color: var(--aic-dim);
    padding: 0;
    margin: 0;
}

.aic-row__system {
    flex-shrink: 0;
    max-width: 120px;
    font-size: 10px;
    -unity-font-style: bold;
    padding: 1px 6px;
    margin: 0 6px 0 0;
    border-radius: 3px;
    overflow: hidden;
}

.aic-row__file {
    max-width: 220px;
    color: var(--aic-accent);
    background-color: var(--aic-raised);
    -unity-font-style: normal;
}

.aic-row__msg {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    padding: 0;
    margin: 0;
}

.aic-row--error .aic-row__msg {
    color: var(--aic-error);
}

.aic-row__fields {
    flex-shrink: 1;
    max-width: 35%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--aic-dim);
    font-size: 11px;
    margin: 0 0 0 8px;
    padding: 0;
}

.aic-row__badge {
    flex-shrink: 0;
    font-size: 10px;
    -unity-font-style: bold;
    color: var(--aic-text);
    background-color: var(--aic-raised);
    border-radius: 8px;
    padding: 0 6px;
    margin-left: 8px;
}

.aic-row__id {
    flex-shrink: 0;
    width: 52px;
    -unity-text-align: middle-right;
    font-size: 10px;
    color: var(--aic-faint);
    padding: 0;
    margin: 0;
}

.aic-row--marker {
    justify-content: center;
}

.aic-row--marker .aic-row__msg {
    flex-grow: 0;
    color: var(--aic-dim);
    -unity-font-style: italic;
    font-size: 11px;
}

.aic-row__rule {
    flex-grow: 1;
    height: 1px;
    margin: 0 10px;
    background-color: var(--aic-border);
}

.aic-row--pinned {
    border-left-width: 2px;
    border-left-color: var(--aic-error);
}

/* ---------- Details ---------- */
.aic-d-header {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 8px;
}

.aic-d-kind {
    font-size: 10px;
    -unity-font-style: bold;
    padding: 2px 7px;
    margin-right: 6px;
    border-radius: 3px;
    color: #ffffff;
}

.aic-d-kind--error { background-color: var(--aic-error); }
.aic-d-kind--warning { background-color: var(--aic-warning); color: #1d1e21; }
.aic-d-kind--log { background-color: var(--aic-faint); }
.aic-d-kind--marker { background-color: var(--aic-faint); }

.aic-d-meta {
    font-size: 11px;
    color: var(--aic-dim);
    margin-right: 10px;
    padding: 0;
}

.aic-d-message {
    margin: 0 0 10px 0;
}

.aic-d-message .unity-text-field__input,
.aic-d-message .unity-base-text-field__input {
    background-color: transparent;
    border-width: 0;
    padding: 0;
    color: var(--aic-text);
    font-size: 13px;
    white-space: normal;
}

.aic-d-section {
    font-size: 10px;
    -unity-font-style: bold;
    color: var(--aic-dim);
    margin: 8px 0 4px 0;
    padding: 0;
    letter-spacing: 1px;
}

.aic-d-kv {
    flex-direction: row;
    padding: 2px 0;
}

.aic-d-kv__key {
    width: 140px;
    color: var(--aic-dim);
    padding: 0;
    margin: 0;
}

.aic-d-kv__value {
    flex-grow: 1;
    padding: 0;
    margin: 0;
}

.aic-d-actions {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 10px;
}

.aic-d-actions > Button {
    margin: 0 6px 4px 0;
    padding: 2px 10px;
}

.aic-frame {
    flex-direction: row;
    align-items: center;
    padding: 2px 6px;
    border-radius: 3px;
}

.aic-frame:hover {
    background-color: var(--aic-hover);
}

.aic-frame__method {
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    padding: 0;
    margin: 0;
}

.aic-frame__file {
    margin-left: 8px;
    color: var(--aic-accent);
    font-size: 11px;
    padding: 0;
    flex-shrink: 0;
}

.aic-frame--user .aic-frame__method {
    -unity-font-style: bold;
}

.aic-frame--engine .aic-frame__method {
    color: var(--aic-faint);
}

.aic-frame--engine .aic-frame__file {
    color: var(--aic-faint);
}

.aic-frame--separator {
    margin-top: 6px;
    padding: 3px 6px;
    background-color: var(--aic-raised);
}

.aic-frame--separator .aic-frame__method {
    color: var(--aic-warning);
    -unity-font-style: bold;
}

.aic-frame-toggle {
    color: var(--aic-dim);
    font-size: 11px;
    padding: 2px 6px;
}

.aic-frame-toggle:hover {
    color: var(--aic-text);
}

.aic-source {
    margin-top: 4px;
    padding: 6px 0;
    border-radius: 4px;
    border-width: 1px;
    border-color: var(--aic-border);
    background-color: var(--aic-code-bg);
}

.aic-source__title {
    font-size: 11px;
    color: var(--aic-dim);
    padding: 0 10px 4px 10px;
}

.aic-source__line {
    flex-direction: row;
    padding: 0 10px;
}

.aic-source__line--hit {
    background-color: var(--aic-code-hl);
}

.aic-source__no {
    width: 44px;
    color: var(--aic-faint);
    -unity-text-align: upper-right;
    margin-right: 12px;
    padding: 0;
    flex-shrink: 0;
}

.aic-source__code {
    white-space: nowrap; /* tabs are expanded in code; spaces are preserved */
    padding: 0;
    margin: 0;
}

.aic-empty {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    color: var(--aic-dim);
    -unity-text-align: middle-center;
}
